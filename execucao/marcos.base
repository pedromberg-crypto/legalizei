filters:
  and:
    - note.tipo == "marco"
properties:
  file.name:
    displayName: Marco
  note.data:
    displayName: Data
  note.area:
    displayName: Área
  note.impacto:
    displayName: Impacto
  note.tempo-gasto:
    displayName: Horas
views:
  - type: table
    name: Todos os marcos
    order:
      - file.name
      - data
      - area
      - impacto
      - tempo-gasto
  - type: table
    name: Por área
    groupBy:
      property: area
      direction: ASC
    order:
      - file.name
      - data
      - impacto
      - tempo-gasto
    summaries:
      tempo-gasto: Sum
